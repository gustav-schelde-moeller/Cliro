# Copy this file to .env (local dev) or paste these into your host's
# environment variables (production). See README.md for the full step-by-step
# guide to getting real values for each of these.

# --- Required ---

# PostgreSQL connection string. Get this from Neon (neon.tech) — see README.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Random secret used to sign session tokens. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# The full public URL of your deployed app (no trailing slash).
NEXTAUTH_URL="https://your-app.vercel.app"

# --- Optional: transactional email (invites, password reset) ---
# Without these, the app still works — invite/reset emails are skipped and
# the exact error is shown in the UI instead of silently failing. Get an API
# key from resend.com — see README.
RESEND_API_KEY=""
EMAIL_FROM="Cliro <onboarding@resend.dev>"

# --- Optional: Google sign-in ---
# Without these, the "Continue with Google" button is disabled and shows a
# note instead. Get these from Google Cloud Console — see README.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
