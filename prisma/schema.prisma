generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  avatarDataUrl String?
  // Required by @auth/prisma-adapter — it writes the OAuth provider's
  // profile picture URL here (e.g. Google) on user creation/update.
  image         String?
  createdAt     DateTime  @default(now())

  accounts         Account[]
  sessions         Session[]
  teamMemberships  TeamMember[]
  ownedTeams       Team[]               @relation("TeamOwner")
  stars            Star[]
  activity         ActivityLog[]
  leadsAssigned    Lead[]               @relation("LeadAssignee")
  resetTokens      PasswordResetToken[]
  cvrLeadsAssigned CvrTeamLead[]        @relation("CvrLeadAssignee")
  cvrStars         CvrStar[]
}

// Standard Auth.js (NextAuth) models — required by the Prisma adapter so
// Google sign-in (once configured) links to the same User row.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Team {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  ownerId   String
  createdAt DateTime @default(now())

  owner        User          @relation("TeamOwner", fields: [ownerId], references: [id])
  members      TeamMember[]
  leads        Lead[]
  activity     ActivityLog[]
  lists        CompanyList[]
  cvrTeamLeads CvrTeamLead[]
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     String   @default("member") // "admin" | "member" — the owner is Team.ownerId, not a role value
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

// The lead dataset shown on the Virksomheder page. Seeded once from the
// original 47 hand-researched companies; new rows are appended daily by
// /api/cron/daily-research (real web-search-grounded research, never
// fabricated) and by nothing else — rows are never deleted or edited, so
// createdAt doubles as a reliable "newest first" / "added this week" signal.
model Company {
  id        Int      @id @default(autoincrement())
  name      String
  website   String
  industry  String
  city      String
  lat       Float
  lng       Float
  score     Int
  breakdown Json // { contact, news, industry, creative }
  dateRank  Int
  tier      Json // { key: "hot" | "warm" | "cool", label }
  hook      Json // { title, summary, date, url }
  existing  String
  social    String
  idea      String
  contact   Json // { found, name, title, email, note, sourceUrl?, profileUrl? }
  mail      Json // { subject, body }
  createdAt DateTime @default(now())
}

// One row per (team, company) that has actually been touched — matches the
// original app's sparse "leads" map. companyId references Company.id.
model Lead {
  id         String   @id @default(cuid())
  teamId     String
  companyId  Int
  status     String   @default("new") // new | contacted | meeting | won | lost
  assigneeId String?
  updatedAt  DateTime @updatedAt

  team     Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignee User? @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@unique([teamId, companyId])
}

// Per-user bookmark, independent of team.
model Star {
  id        String @id @default(cuid())
  userId    String
  companyId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

model ActivityLog {
  id          String   @id @default(cuid())
  teamId      String
  userId      String?
  who         String
  action      String
  companyName String?
  createdAt   DateTime @default(now())

  team Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// Named, team-shared batches of companies (e.g. "Denne uges ringerunde")
// for organizing and exporting call sessions. companyId is a loose
// reference to Company.id, same convention as Lead/Star. isPrivate defaults
// to false so every existing list keeps its current (team-visible) behavior.
model CompanyList {
  id        String   @id @default(cuid())
  teamId    String
  name      String
  createdBy String
  isPrivate Boolean  @default(false)
  // Whether teammates other than the owner can add/remove companies on a
  // visible (non-private) list — separate from isPrivate, which controls
  // who can even see it. Defaults true so existing public lists keep their
  // current behavior (any team member could already edit them).
  teamCanEdit Boolean  @default(true)
  createdAt   DateTime @default(now())

  team     Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  items    CompanyListItem[]
  cvrItems CvrListItem[]

  @@unique([teamId, name])
}

model CompanyListItem {
  id        String   @id @default(cuid())
  listId    String
  companyId Int
  addedBy   String
  addedAt   DateTime @default(now())

  list CompanyList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, companyId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// The full Danish CVR business registry (~420k active companies) — a
// separate, much larger dataset from Company (which is the small,
// AI-curated news-lead list). Mirrors the schema of the handed-off
// cvr-tool's SQLite db exactly, including its column names via @map, so
// the migration script can copy rows through unchanged.
model CvrCompany {
  cvrNummer               String  @id @map("cvr_nummer")
  cvrEnhedsId             String? @map("cvr_enheds_id")
  status                  String
  startdato               String?
  ophoersdato             String?
  virksomhedsformKode     String? @map("virksomhedsform_kode")
  virksomhedsformTekst    String? @map("virksomhedsform_tekst")
  navn                    String? // ~123 of 420k real rows have no registered name
  brancheKode             String? @map("branche_kode")
  brancheTekst            String? @map("branche_tekst")
  email                   String?
  telefon                 String?
  vejnavn                 String?
  husnummer               String?
  etage                   String?
  doer                    String?
  postnummer              String?
  postdistrikt            String?
  kommunekode             String?
  kommunenavn             String?
  supplerendeBynavn       String? @map("supplerende_bynavn")
  adresseFritekst         String? @map("adresse_fritekst")
  landekode               String?
  produktionsenhederAntal Int     @default(0) @map("produktionsenheder_antal")
  employees               Int?
  sizeBucket              String? @map("size_bucket")
  // Float, not Int: large companies' DKK figures exceed Postgres's 32-bit
  // Int range (seen: 3.6 billion) — SQLite's own INTEGER is 64-bit so the
  // source data never hit this. Values are whole kroner with no decimals;
  // a JS double's 53-bit integer precision is far more than enough.
  likvideBeholdninger     Float?  @map("likvide_beholdninger")
  egenkapital             Float?
  driftsresultat          Float?
  nettoresultat           Float?
  udbetaltUdbytte         Float?  @map("udbetalt_udbytte")
  kapitalforoegelse       Float?
  regnskabAar             Int?    @map("regnskab_aar")
  koebekraftScore         Int?    @map("koebekraft_score")

  // Backfilled — lat/lng from Danish postnummer centroids (DAWA), region
  // from the REGION_BY_KOMMUNEKODE lookup already used at query time
  // (src/lib/cvr/filters.ts). See scripts/backfill-cvr-derived-fields.mjs.
  lat    Float?
  lng    Float?
  region String?

  teamLeads CvrTeamLead[]
  stars     CvrStar[]
  listItems CvrListItem[]
  analysis  CvrAnalysis?

  @@index([status])
  @@index([brancheKode])
  @@index([postnummer])
  @@index([kommunekode])
  @@index([navn])
  @@index([region])
  @@index([lat, lng])
  @@map("cvr_companies")
}

// Team-scoped CVR pipeline state — the CVR-registry equivalent of Lead
// (same status vocabulary, see src/lib/status.ts's STATUS_DEFS).
model CvrTeamLead {
  id         String   @id @default(cuid())
  teamId     String
  cvrNummer  String
  status     String   @default("new")
  assigneeId String?
  updatedAt  DateTime @updatedAt

  team     Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  company  CvrCompany @relation(fields: [cvrNummer], references: [cvrNummer], onDelete: Cascade)
  assignee User?      @relation("CvrLeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@unique([teamId, cvrNummer])
  @@map("cvr_team_leads")
}

// Per-user bookmark for CVR companies — the CVR-registry equivalent of Star.
model CvrStar {
  id        String @id @default(cuid())
  userId    String
  cvrNummer String

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  company CvrCompany @relation(fields: [cvrNummer], references: [cvrNummer], onDelete: Cascade)

  @@unique([userId, cvrNummer])
  @@map("cvr_stars")
}

// CVR-registry join for CompanyList — separate table from CompanyListItem
// because CvrCompany's key is a String (cvrNummer), not the Int companyId
// CompanyListItem uses for the AI-lead Company table.
model CvrListItem {
  id        String   @id @default(cuid())
  listId    String
  cvrNummer String
  addedBy   String
  addedAt   DateTime @default(now())

  list    CompanyList @relation(fields: [listId], references: [id], onDelete: Cascade)
  company CvrCompany  @relation(fields: [cvrNummer], references: [cvrNummer], onDelete: Cascade)

  @@unique([listId, cvrNummer])
  @@map("cvr_list_items")
}

// On-demand AI research result for a CVR company, triggered by a user
// clicking "Analysér med AI" (src/app/api/cvr/analyze/[cvr]/route.ts) — the
// CVR-registry equivalent of Company's own enrichment fields (hook,
// breakdown, tier, existing, social, idea, contact, mail), kept as a
// separate 1:1 table rather than columns on CvrCompany, matching the
// CvrTeamLead/CvrStar/CvrListItem pattern already used for other per-company
// enrichment. hook is nullable: unlike the daily-research cron (which only
// ever confirms a pre-found same-day candidate), this route searches for
// *any* genuine, sourced news with no recency requirement — if a real
// search turns up nothing, hook stays null rather than being invented.
model CvrAnalysis {
  cvrNummer  String   @id
  score      Int
  breakdown  Json // {contact, news, industry, creative} — same 0-30/0-35/0-20/0-15 rubric as Company.breakdown
  tier       Json // {key, label}
  hook       Json? // {title, summary, date, url} | null
  existing   String
  social     String
  idea       String
  contact    Json // {found, name, title, email, note, sourceUrl, profileUrl}
  mail       Json // {subject, body}
  analyzedBy String
  analyzedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company CvrCompany @relation(fields: [cvrNummer], references: [cvrNummer], onDelete: Cascade)

  @@map("cvr_analyses")
}

// Financial dashboard data — replaces financial-dashboard's local JSON
// file store (server/src/lib/store.ts) now that it runs as part of Cliro.
model FinTransaction {
  id           String  @id
  source       String
  date         String
  description  String
  counterparty String?
  amount       Float
  category     String

  @@index([date])
  @@map("fin_transactions")
}

// Wholesale-replaced (deleteMany + createMany) on every "refresh sheets" —
// matches the original's overwrite-the-whole-array-to-JSON behavior, so no
// versioning/history is kept, same as before.
model FinPipelineRow {
  id        String  @id @default(cuid())
  date      String
  client    String
  status    String
  segment   String
  type      String
  vat       Boolean
  revenue   Float
  vatAmount Float
  inclVat   Float

  @@map("fin_pipeline")
}

model FinProspectiveRow {
  id      String @id @default(cuid())
  client  String
  segment String
  type    String
  status  String
  revenue Float

  @@map("fin_prospective")
}

model FinRecurringRow {
  id            String  @id @default(cuid())
  vendor        String
  category      String
  monthlyAmount Float
  vat           Boolean
  vatAmount     Float
  totalAmount   Float
  startDate     String
  endDate       String

  @@map("fin_recurring")
}

// Singleton row (id is always "singleton") for cash position + salaries.
model FinSettings {
  id            String    @id @default("singleton")
  cashBalance   Float?
  cashAsOf      DateTime?
  salaries      Json
  lastSheetSync DateTime?

  @@map("fin_settings")
}

model FinImportLog {
  id      String   @id @default(cuid())
  source  String
  file    String
  added   Int
  skipped Int
  at      DateTime @default(now())

  @@map("fin_import_log")
}
